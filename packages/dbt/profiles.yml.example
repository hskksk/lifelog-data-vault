# Copy to profiles.yml (gitignored). CI: owntracks-dbt.yml + resolve-dbt-connection.ts — see docs/operations/dbt-ci-setup.md

lifelog_vault:
  target: supabase_local
  outputs:
    local:
      type: postgres
      host: localhost
      user: lifelog
      password: lifelog
      port: 5432
      dbname: lifelog
      schema: staging
      threads: 2
    supabase_local:
      type: postgres
      host: 127.0.0.1
      user: postgres
      password: postgres
      port: 54422
      dbname: postgres
      schema: staging
      threads: 2
    supabase_dbt_runner:
      type: postgres
      host: 127.0.0.1
      user: dbt_runner
      password: local-dbt-runner
      port: 54422
      dbname: postgres
      schema: staging
      threads: 2
    # CI: owntracks-dbt.yml generates profiles.yml with DBT_PG_* env vars (dbt 1.12+).
    ci:
      type: postgres
      host: "{{ env_var('DBT_PG_HOST') }}"
      user: "{{ env_var('DBT_PG_USER') }}"
      password: "{{ env_var('DBT_PG_PASSWORD') }}"
      port: "{{ env_var('DBT_PG_PORT') | int }}"
      dbname: "{{ env_var('DBT_PG_DBNAME') }}"
      sslmode: "{{ env_var('DBT_PG_SSLMODE') }}"
      schema: staging
      threads: 2
