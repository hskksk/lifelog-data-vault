# Copy to profiles.yml (gitignored). CI: dbt.yml + resolve-dbt-connection.ts — see docs/operations/dbt-ci-setup.md

lifelog_vault:
  target: supabase_local
  outputs:
    local:
      type: postgres
      host: localhost
      user: lifelog
      password: lifelog
      port: 5432
      dbname: lifelog
      schema: staging
      threads: 2
    supabase_local:
      type: postgres
      host: 127.0.0.1
      user: postgres
      password: postgres
      port: 54422
      dbname: postgres
      schema: staging
      threads: 2
    supabase_dbt_runner:
      type: postgres
      host: 127.0.0.1
      user: dbt_runner
      password: local-dbt-runner
      port: 54422
      dbname: postgres
      schema: staging
      threads: 2
    # CI: dbt.yml generates profiles.yml with DBT_PG_* env vars (dbt 1.12+).
    ci:
      type: postgres
      host: "{{ env_var('DBT_PG_HOST') }}"
      user: "{{ env_var('DBT_PG_USER') }}"
      password: "{{ env_var('DBT_PG_PASSWORD') }}"
      port: "{{ env_var('DBT_PG_PORT') | int }}"
      dbname: "{{ env_var('DBT_PG_DBNAME') }}"
      sslmode: "{{ env_var('DBT_PG_SSLMODE') }}"
      schema: staging
      threads: 2
    # Lightdash CLI deploy from the host (make supabase-reset): no SSL on local Supabase.
    bi_reader_local:
      type: postgres
      host: 127.0.0.1
      user: bi_reader
      password: local-bi-reader
      port: 54422
      dbname: postgres
      schema: mart
      threads: 1
      sslmode: disable
    # Lightdash in Docker (make lightdash-up): session pooler from the container.
    bi_reader:
      type: postgres
      host: host.docker.internal
      user: bi_reader
      password: local-bi-reader
      port: 54422
      dbname: postgres
      schema: mart
      threads: 1
      sslmode: disable
    # Hosted session pooler — local production: make lightdash-install-ca then use this path.
    # Lightdash CLI needs a literal path (no env_var). Host/user/password from: pnpm lightdash-print-warehouse
    bi_reader_hosted:
      type: postgres
      host: REPLACE_ME.pooler.supabase.com
      user: bi_reader.REPLACE_ME
      password: REPLACE_ME
      port: 5432
      dbname: postgres
      sslmode: require
      sslrootcert: /absolute/path/to/lifelog-data-vault/deploy/docker/lightdash/certs/supabase-ca.pem
      schema: mart
      threads: 1
