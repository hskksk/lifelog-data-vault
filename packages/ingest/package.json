{
  "name": "@lifelog/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lifelog-ingest": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean --banner.cli='#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@hono/node-server": "^1.14.0",
    "h3-js": "^4.1.0",
    "hono": "^4.7.0",
    "pg": "^8.13.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
