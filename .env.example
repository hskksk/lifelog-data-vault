# PostgreSQL (local compose or OCI)
DATABASE_URL=postgresql://lifelog:lifelog@localhost:5432/lifelog

# Cloudflare R2 (S3 API)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lifelog-bronze

# Local Bronze when R2_* unset (dev)
BRONZE_LOCAL_DIR=var/bronze

# OwnTracks webhook (Cloudflare Tunnel → localhost:8080)
INGEST_BEARER_TOKEN=change-me
PERSON_MAP_PATH=config/person_map.yml
