# --- Supabase local (preferred: make supabase-start && make supabase-reset) ---
# Keys/URLs: npx supabase status -o json
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# --- Legacy Docker Compose Postgres (make up && make migrate) ---
# DATABASE_URL=postgresql://lifelog:lifelog@localhost:5432/lifelog

# Cloudflare R2 (S3 API) — optional until Edge ingest (S2); local dev may use BRONZE_LOCAL_DIR
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lifelog-bronze

# Local Bronze when R2_* unset (dev CLI against @lifelog/ingest)
BRONZE_LOCAL_DIR=var/bronze

# OwnTracks webhook bearer (local Hono or future Edge)
INGEST_BEARER_TOKEN=change-me
PERSON_MAP_PATH=config/person_map.yml

# Edge materialize (S3): optional YAML inline; else upload config/person_map.yml to Storage bucket bronze
# PERSON_MAP_YAML=
# MATERIALIZE_MAX_BATCHES=20
# MATERIALIZE_MAX_FILES_PER_BATCH=50
