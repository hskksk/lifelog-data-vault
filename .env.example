# --- Supabase local (preferred: make supabase-start && make supabase-reset) ---
# URL/DB: npx supabase status -o json
# Secret key (sb_secret_...): Dashboard → Settings → API Keys → Secret (not legacy service_role JWT)
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# --- Legacy Docker Compose Postgres (make up && make migrate) ---
# DATABASE_URL=postgresql://lifelog:lifelog@localhost:5432/lifelog

# Cloudflare R2 (S3 API) — optional until Edge ingest (S2); local dev may use BRONZE_LOCAL_DIR
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lifelog-bronze

# Local Bronze when R2_* unset (dev CLI against @lifelog/ingest)
BRONZE_LOCAL_DIR=var/bronze

# OwnTracks webhook bearer (local Hono or future Edge)
INGEST_BEARER_TOKEN=change-me

# Edge materialize batch limits
# MATERIALIZE_MAX_BATCHES=20
# MATERIALIZE_MAX_FILES_PER_BATCH=50

# GitHub Actions only (session pooler URL for dbt_runner):
# SUPABASE_DB_URL=postgresql://dbt_runner.[project-ref]:...@...pooler.supabase.com:5432/postgres

# Metabase local UI: make metabase-up (http://127.0.0.1:${METABASE_PORT:-3000})
# Warehouse login after make supabase-reset: bi_reader / local-bi-reader, schema mart.
# METABASE_PORT=3000

# Add the hosted mart to that Metabase (make metabase-connect-remote).
# Uses SUPABASE_DB_PASSWORD + SUPABASE_PROJECT_REF to read Vault bi_reader_password (same as dbt).
# Auth to Metabase: METABASE_API_KEY, or METABASE_EMAIL + METABASE_PASSWORD.
# METABASE_URL=http://127.0.0.1:3000
# METABASE_API_KEY=
# METABASE_EMAIL=
# METABASE_PASSWORD=

# Optional on `pnpm deploy`: upsert Vault bi_reader_password, then sync the role.
# GitHub Actions reads repository secret BI_READER_PASSWORD (empty = skip upsert).
# BI_READER_PASSWORD=
