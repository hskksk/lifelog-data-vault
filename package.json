{
  "name": "lifelog-data-vault",
  "private": true,
  "packageManager": "pnpm@9.14.0",
  "scripts": {
    "typecheck": "pnpm --filter @lifelog/ingest-core typecheck && pnpm --filter @lifelog/ingest typecheck",
    "test": "pnpm --filter @lifelog/ingest-core test && pnpm --filter @lifelog/ingest test",
    "ingest": "pnpm --filter @lifelog/ingest exec lifelog-ingest",
    "deploy": "tsx scripts/deploy.ts",
    "resolve-dbt-db-url": "tsx scripts/resolve-dbt-db-url.ts",
    "resolve-dbt-connection": "tsx scripts/resolve-dbt-connection.ts",
    "test:bi-connection": "tsx scripts/lib/bi-connection.test.ts && tsx scripts/lib/metabase-remote.test.ts",
    "metabase-connect-remote": "tsx scripts/metabase-add-remote.ts"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "tsx": "^4.19.4"
  }
}
