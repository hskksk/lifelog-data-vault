# Self-hosted Lightdash: GitHub App for org-level OAuth (optional).
# Without these, "Connect GitHub" in Organization settings falls back to Lightdash's
# dev proxy (github-proxy-dev.onrender.com) and OAuth fails with "missing parameter".
#
# Guide: https://docs.lightdash.com/self-host/customize-deployment/configure-github-for-lightdash
#
# Callback URL in the GitHub App (no path on GITHUB_REDIRECT_DOMAIN):
#   https://<GITHUB_REDIRECT_DOMAIN>/api/v1/github/oauth/callback
#
# SITE_URL must be the full public URL users open (scheme + host + port if non-443).
# Behind reverse proxy: TRUST_PROXY=true, SECURE_COOKIES=true

# GITHUB_APP_NAME=your-unique-app-name
# GITHUB_APP_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY=   # base64 of the .pem private key (single line)
# GITHUB_REDIRECT_DOMAIN=bi.example.com
# SITE_URL=https://bi.example.com
# TRUST_PROXY=true
# SECURE_COOKIES=true