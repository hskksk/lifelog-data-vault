[Unit]
Description=Lifelog OwnTracks ingest webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lifelog
WorkingDirectory=/opt/lifelog-data-vault
EnvironmentFile=/etc/lifelog/env
ExecStart=/opt/lifelog-data-vault/.venv/bin/lifelog-ingest serve owntracks --host 127.0.0.1 --port 8080
Restart=on-failure

[Install]
WantedBy=multi-user.target
