<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Registration commands are in the README (Mac power, Screen Time, Health).
  install-app.sh substitutes REPLACE_WITH_HOME.

  The agent runs ~/Applications/Lifelog Collect.app. It does not read the
  checkout. Grant Full Disk Access to that app, not to /bin/sh or node.

  ingest_url stays in ~/Library/Application Support/lifelog/config.json.
  The bearer token stays in the keychain (service lifelog-macos-ingest).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.lifelog.macos-collect</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_HOME/Applications/Lifelog Collect.app/Contents/MacOS/lifelog-macos-collect</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_HOME/Library/Logs/lifelog-macos-collect.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_HOME/Library/Logs/lifelog-macos-collect.err.log</string>
</dict>
</plist>
