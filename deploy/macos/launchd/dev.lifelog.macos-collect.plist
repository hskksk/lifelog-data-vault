<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Registration commands are in the README (Mac power, Screen Time, Health).
  The installed plist must not still contain REPLACE_WITH_REPO or REPLACE_WITH_HOME.

  Build deploy/macos/lifelog-macos-collect with go, then point this agent at it.
  A shell script cannot hold its own Full Disk Access grant: the shebang still
  runs /bin/sh. Grant Full Disk Access to lifelog-macos-collect only.

  ingest_url stays in ~/Library/Application Support/lifelog/config.json.
  The bearer token stays in the keychain (service lifelog-macos-ingest).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.lifelog.macos-collect</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_REPO/deploy/macos/lifelog-macos-collect</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_HOME/Library/Logs/lifelog-macos-collect.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_HOME/Library/Logs/lifelog-macos-collect.err.log</string>
</dict>
</plist>
